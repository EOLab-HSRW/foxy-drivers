#!/bin/sh
set -e

STATE_DIR=/var/lib/foxy-drivers
mkdir -p "$STATE_DIR"

add_user_to_group_once() {
    user="$1"
    group="$2"
    marker="$3"

    if getent passwd "$user" >/dev/null && getent group "$group" >/dev/null; then
        if ! id -nG "$user" | tr ' ' '\n' | grep -qx "$group"; then
            adduser "$user" "$group"
            touch "$STATE_DIR/$marker"
        fi
    fi
}

reload_udev() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=tty || true
        udevadm trigger --subsystem-match=i2c-dev || true
        udevadm trigger --subsystem-match=gpio || true
    fi
}

# Create unified Foxy hardware-access group.
if ! getent group foxyhw >/dev/null; then
    addgroup --system foxyhw
    touch "$STATE_DIR/created-group-foxyhw"
fi

# Create unified Foxy power-control group.
if ! getent group foxypower >/dev/null; then
    addgroup --system foxypower
    touch "$STATE_DIR/created-group-foxypower"
fi

# Create unified Foxy hardware-access user.
if ! getent passwd foxyhw >/dev/null; then
    adduser \
        --system \
        --ingroup foxyhw \
        --home /nonexistent \
        --no-create-home \
        --shell /usr/sbin/nologin \
        --gecos "Foxy hardware access" \
        foxyhw

    touch "$STATE_DIR/created-user-foxyhw"
fi

# On Foxy robot images, the default ROS/user account is "foxy".
# Primary package model: foxy -> foxyhw.
add_user_to_group_once foxy foxyhw added-foxy-to-foxyhw

# Platform fallback model.
# Some base images keep /dev/gpiochip0 and /dev/i2c-1 owned by gpio/i2c.
# Add foxy to those groups only when they already exist.
add_user_to_group_once foxy gpio added-foxy-to-gpio
add_user_to_group_once foxy i2c added-foxy-to-i2c

# Allow the battery daemon user to request controlled robot poweroff.
add_user_to_group_once foxyhw foxypower added-foxyhw-to-foxypower

reload_udev

#DEBHELPER#

exit 0

#!/bin/sh
set -e

STATE_DIR=/var/lib/foxy-drivers

remove_user_from_group_if_package_added() {
    user="$1"
    group="$2"
    marker="$3"

    if [ -f "$STATE_DIR/$marker" ] \
        && getent passwd "$user" >/dev/null \
        && getent group "$group" >/dev/null; then
        deluser "$user" "$group" || true
    fi
}

reload_udev() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=tty || true
        udevadm trigger --subsystem-match=i2c-dev || true
        udevadm trigger --subsystem-match=gpio || true
    fi
}

case "$1" in
    remove)
        # Package files are removed by dpkg.
        # Keep users, groups, and memberships on normal remove.
        # Reload udev so removed package rules stop applying to future devices.
        reload_udev
        ;;

    purge)
        # Undo only memberships this package added.
        # Do not remove memberships that existed before installation.
        remove_user_from_group_if_package_added foxy i2c added-foxy-to-i2c
        remove_user_from_group_if_package_added foxy gpio added-foxy-to-gpio
        remove_user_from_group_if_package_added foxy foxyhw added-foxy-to-foxyhw
        remove_user_from_group_if_package_added foxyhw foxypower added-foxyhw-to-foxypower

        # Remove package-created system user.
        # Do this before removing foxyhw, because foxyhw is the user's primary group.
        if [ -f "$STATE_DIR/created-user-foxyhw" ] && getent passwd foxyhw >/dev/null; then
            deluser --system foxyhw || true
        fi

        # Remove package-created power group.
        # This may fail if an admin added other users; do not abort purge.
        if [ -f "$STATE_DIR/created-group-foxypower" ] && getent group foxypower >/dev/null; then
            delgroup --system foxypower || true
        fi

        # Remove package-created hardware group.
        # This may fail if an admin added other users; do not abort purge.
        if [ -f "$STATE_DIR/created-group-foxyhw" ] && getent group foxyhw >/dev/null; then
            delgroup --system foxyhw || true
        fi

        rm -rf "$STATE_DIR"

        reload_udev
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        ;;
esac

#DEBHELPER#

exit 0
